{
    "annotations": { "list": [] },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 2,
    "id": null,
    "links": [
        { "title": "← Overview", "url": "/grafana/d/ft-transcendence-overview", "type": "link", "icon": "arrow-left", "targetBlank": false }
    ],
    "panels": [
        {
            "collapsed": false,
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
            "id": 100,
            "title": "📊 CONTAINER RESOURCE USAGE",
            "type": "row"
        },
        {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "continuous-BlYlRd" },
                    "unit": "percentunit",
                    "min": 0,
                    "max": 1,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "value": null, "color": "green" },
                            { "value": 0.7, "color": "yellow" },
                            { "value": 0.9, "color": "red" }
                        ]
                    }
                }
            },
            "gridPos": { "h": 6, "w": 24, "x": 0, "y": 1 },
            "id": 1,
            "options": {
                "reduceOptions": { "calcs": ["lastNotNull"] },
                "orientation": "horizontal",
                "displayMode": "gradient",
                "showUnfilled": true
            },
            "title": "CPU Usage by Container",
            "type": "bargauge",
            "targets": [
                { "expr": "label_replace(rate(container_cpu_usage_seconds_total{id=~\"/docker/.*\", cpu=\"total\"}[5m]), \"container\", \"$1\", \"name\", \"(.+)\")", "legendFormat": "{{ name }}{{ container }}{{ id }}" }
            ]
        },
        {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "continuous-BlYlRd" },
                    "unit": "bytes",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "value": null, "color": "green" },
                            { "value": 536870912, "color": "yellow" },
                            { "value": 1073741824, "color": "red" }
                        ]
                    }
                }
            },
            "gridPos": { "h": 6, "w": 24, "x": 0, "y": 7 },
            "id": 2,
            "options": {
                "reduceOptions": { "calcs": ["lastNotNull"] },
                "orientation": "horizontal",
                "displayMode": "gradient",
                "showUnfilled": true
            },
            "title": "Memory Usage by Container",
            "type": "bargauge",
            "targets": [
                { "expr": "container_memory_usage_bytes{id=~\"/docker/.*\"}", "legendFormat": "{{ name }}{{ id }}" }
            ]
        },
        {
            "collapsed": false,
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
            "id": 101,
            "title": "📈 CPU OVER TIME",
            "type": "row"
        },
        {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "palette-classic" },
                    "unit": "percentunit",
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 20,
                        "gradientMode": "opacity",
                        "showPoints": "never",
                        "spanNulls": true,
                        "lineInterpolation": "smooth"
                    }
                }
            },
            "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
            "id": 3,
            "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "last"] }, "tooltip": { "mode": "multi" } },
            "title": "CPU Usage Over Time",
            "type": "timeseries",
            "targets": [
                { "expr": "rate(container_cpu_usage_seconds_total{id=~\"/docker/.*\", cpu=\"total\"}[5m])", "legendFormat": "{{ name }}{{ id }}" }
            ]
        },
        {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "palette-classic" },
                    "unit": "bytes",
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 20,
                        "gradientMode": "opacity",
                        "showPoints": "never",
                        "spanNulls": true,
                        "lineInterpolation": "smooth"
                    }
                }
            },
            "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
            "id": 4,
            "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "last"] }, "tooltip": { "mode": "multi" } },
            "title": "Memory Usage Over Time",
            "type": "timeseries",
            "targets": [
                { "expr": "container_memory_usage_bytes{id=~\"/docker/.*\"}", "legendFormat": "{{ name }}{{ id }}" }
            ]
        },
        {
            "collapsed": false,
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
            "id": 102,
            "title": "🔄 NETWORK I/O",
            "type": "row"
        },
        {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "palette-classic" },
                    "unit": "Bps",
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 15,
                        "gradientMode": "opacity",
                        "showPoints": "never",
                        "spanNulls": true,
                        "lineInterpolation": "smooth"
                    }
                }
            },
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
            "id": 5,
            "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
            "title": "Network Received (RX)",
            "type": "timeseries",
            "targets": [
                { "expr": "rate(container_network_receive_bytes_total{id=~\"/docker/.*\"}[5m])", "legendFormat": "{{ name }}{{ id }}" }
            ]
        },
        {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "palette-classic" },
                    "unit": "Bps",
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 15,
                        "gradientMode": "opacity",
                        "showPoints": "never",
                        "spanNulls": true,
                        "lineInterpolation": "smooth"
                    }
                }
            },
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
            "id": 6,
            "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
            "title": "Network Transmitted (TX)",
            "type": "timeseries",
            "targets": [
                { "expr": "rate(container_network_transmit_bytes_total{id=~\"/docker/.*\"}[5m])", "legendFormat": "{{ name }}{{ id }}" }
            ]
        }
    ],
    "schemaVersion": 39,
    "tags": ["ft_transcendence", "docker", "cadvisor"],
    "templating": { "list": [] },
    "time": { "from": "now-1h", "to": "now" },
    "title": "Docker Containers",
    "uid": "ft-docker-containers",
    "description": "Container-level resource monitoring via cAdvisor"
}
